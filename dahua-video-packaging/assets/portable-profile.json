    "hyperframes": "0.8.4",
    "python": "3.14.3",
    "pillow": "12.2.0",
    "ffmpeg": {"versionPrefix": "8.0.1", "requireLibass": true}
  },
  "policy": {
    "noAbsolutePathsInSkill": true,
    "noUserIdentityInArtifacts": true,
    "noSharedMutableProjectState": true,
    "newColorsFontsOrMotionRequireNewProfileVersion": true
