{
  "schemaVersion": 1,
  "profileId": "dahua-portable-v1",
  "profileVersion": "1.0.0",
  "defaultStrict": true,
  "creativeExtensionsAllowed": false,
  "canvas": {
    "vertical": {"width": 1080, "height": 1920, "publishWidth": 1440, "publishHeight": 2560},
    "landscape": {"width": 1920, "height": 1080},
    "fps": 30
  },
  "colors": {
    "black": "#000000",
    "paper": "#F7F4ED",
    "white": "#FFFFFF",
    "captionWhite": "#F4F4F1",
    "yellow": "#F3B724",
    "evidenceYellow": "#EBAB14",
    "red": "#DB6A5D",
    "coverBlueLight": "#BFD9FE",
    "coverBlue": "#235394",
    "coverBlueDark": "#20365D"
  },
  "allowedCssRgbFunctions": [
    "rgba(0,0,0,0.46)",
    "rgba(0,0,0,0.5)",
    "rgba(0,0,0,0.54)",
    "rgba(0,0,0,0.88)",
    "rgba(0,0,0,0.95)",
    "rgba(0,0,0,0.96)",
    "rgba(0,0,0,0.98)",
    "rgba(243,183,36,0.24)",
    "rgba(243,183,36,0.72)",
    "rgba(247,244,237,0.05)",
    "rgba(247,244,237,0.14)"
  ],
  "fonts": {
    "body": {
      "family": "Noto Sans SC",
