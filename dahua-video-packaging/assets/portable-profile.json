  "motion": {
    "allowedEases": ["linear", "power2.in", "power2.out", "power2.inOut", "power3.inOut"],
    "allowedFamilies": ["fade", "short-slide", "underline-draw", "strike-draw", "arrow-draw", "semantic-reflow", "direct-cut", "short-crossfade"],
    "forbiddenTerms": ["bounce", "elastic", "back.in", "back.out", "back.inOut", "spring", "wiggle", "shake", "particle", "confetti", "hue-rotate", "rotate(", "skew(", "repeat: -1", "repeat:-1", "yoyo: true", "yoyo:true"]
  },
